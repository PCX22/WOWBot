# Copia este archivo como .env y rellénalo. No subas .env a ningún sitio: lleva el token del bot.

# Token del bot (Discord Developer Portal → tu aplicación → Bot → Reset Token)
DISCORD_TOKEN=

# ID del servidor de Discord de la hermandad (clic derecho en el servidor → Copiar ID, con el modo desarrollador activado).
# Con él los comandos aparecen al momento; sin él tardan hasta una hora.
GUILD_ID=

# MODO LOCAL: si WEB_URL o WEB_API_TOKEN están vacíos, el bot funciona sin web y guarda él los personajes
# (/registro) y los grupos. Sirve para probarlo mientras no esté la web; cuando esté, se rellenan los tres de abajo.
#
# La web de la hermandad (Guildbook) es el centro de todo. El bot solo habla con su API (no con su base de datos):
# LEE de ella los miembros y sus personajes, y GUARDA en ella los grupos.
# Dirección pública de la web (también para los enlaces: «añade tus personajes en …»).
WEB_URL=
# La clave que la web tiene en BOT_API_TOKEN (la misma en los dos sitios).
WEB_API_TOKEN=
# El subdominio (slug) de la hermandad en la web.
WEB_GUILD_SLUG=
# Dirección de la API si no es WEB_URL; en el mismo servidor puede ir por la red interna (p. ej. http://web:3000).
WEB_API_URL=
# Cada cuántos segundos se vuelve a leer la web como mucho.
WEB_REFRESCO_SEGUNDOS=60

# Canales (clic derecho → Copiar ID). Si se dejan vacíos, se publica en el canal donde se usa el comando.
RAID_CHANNEL_ID=
DUNGEON_CHANNEL_ID=
LFG_CHANNEL_ID=

# Permisos por roles de Discord (nombres o IDs, separados por comas; dan igual mayúsculas, tildes y emojis).
# Oficiales: gestionan cualquier grupo (cerrar, cancelar, reserva, quitar gente). Quien puede «Gestionar servidor»,
# siempre. En modo web, además, los oficiales y administradores de la web.
ROLES_OFICIAL=Oficial
# Quién puede crear raids (además de los oficiales). Vacío: cualquiera. Las mazmorras y /lfg, siempre todos.
PERMISO_CREAR_RAID=

# Leer el texto de los mensajes, para /registro importar (el canal donde cada uno contó su personaje).
# Hace falta activar antes «Message Content Intent» en el portal de Discord (Bot → Privileged Gateway Intents).
LEER_MENSAJES=0

TIMEZONE=Europe/Madrid

# Roles automáticos de Discord: clase, rol (Tanque/Sanador/DPS) y profesiones principales.
ROLES_CLASE=1
ROLES_ROL=1
ROLES_PROFESION=0

RECORDATORIO_MINUTOS=30
LFG_HORAS=2

# Dónde se guarda la base de datos propia del bot (por defecto ./datos). Hoy solo la usan las partes desactivadas
# de recetas; los grupos están en la web.
# DATA_DIR=
